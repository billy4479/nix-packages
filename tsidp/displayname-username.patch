+// Copyright (c) Tailscale Inc & AUTHORS
+// SPDX-License-Identifier: BSD-3-Clause
+
+package server
+
+import "strings"
+
+// usernameFromDisplayName derives an OIDC username claim from a WhoIs
+// display name. headscale builds its WhoIs user profile as
+//
+//	DisplayName = cmp.Or(DisplayName, Username())
+//	LoginName   = cmp.Or(Email, Name, ProviderIdentifier, ID)
+//
+// so DisplayName carries the human display name (e.g. "Jack", "Mary Jane")
+// and LoginName usually carries the email address. The deployment invariant
+// is that every headscale user has a display name whose normalized form
+// equals their short username: lowercase, with spaces replaced by
+// underscores.
+//
+// It returns "" when no username can be derived this way, in which case
+// callers fall back to the LoginName local part: an empty or whitespace-only
+// display name, or one that is an email address (headscale fell back to the
+// email because no display name was set, and the local part of an email is
+// not a username).
+func usernameFromDisplayName(displayName string) string {
+	name := strings.TrimSpace(displayName)
+	if name == "" || strings.Contains(name, "@") {
+		return ""
+	}
+	return strings.ReplaceAll(strings.ToLower(name), " ", "_")
+}
