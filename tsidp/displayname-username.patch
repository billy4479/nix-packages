+// TestUsernameFromDisplayName covers usernameFromDisplayName in isolation:
+// lowercase, spaces to underscores, trimming, and the guards that signal
+// "no display-name username available" by returning "".
+func TestUsernameFromDisplayName(t *testing.T) {
+	tests := []struct {
+		name        string
+		displayName string
+		want        string
+	}{
+		{name: "lowercased", displayName: "Jack", want: "jack"},
+		{name: "spaces become underscores", displayName: "Mary Jane", want: "mary_jane"},
+		{name: "surrounding whitespace trimmed", displayName: "  Jack  ", want: "jack"},
+		{name: "email-shaped display name rejected", displayName: "jack@example.com", want: ""},
+		{name: "empty display name", displayName: "", want: ""},
+		{name: "whitespace-only display name", displayName: "   ", want: ""},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := usernameFromDisplayName(tt.displayName); got != tt.want {
+				t.Errorf("usernameFromDisplayName(%q) = %q, want %q", tt.displayName, got, tt.want)
+			}
+		})
+	}
+}
+
+// displaynameTestUser is the WhoIs identity used below: headscale builds
+// LoginName from the user's email and DisplayName from their display name.
+func displaynameTestUser(loginName, displayName string) *apitype.WhoIsResponse {
+	return &apitype.WhoIsResponse{
+		Node: &tailcfg.Node{
+			ID:   1,
+			Name: "node1.example.ts.net",
+			User: tailcfg.UserID(1),
+		},
+		UserProfile: &tailcfg.UserProfile{
+			LoginName:   loginName,
+			DisplayName: displayName,
+		},
+	}
+}
+
+// decodeIDTokenClaims decodes the JWT payload of an ID token.
+func decodeIDTokenClaims(t *testing.T, token string) map[string]any {
+	t.Helper()
+	parts := strings.Split(token, ".")
+	if len(parts) != 3 {
+		t.Fatalf("malformed JWT: %q", token)
+	}
+	payload, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil {
+		t.Fatalf("failed to decode JWT payload: %v", err)
+	}
+	var claims map[string]any
+	if err := json.Unmarshal(payload, &claims); err != nil {
+		t.Fatalf("failed to unmarshal JWT payload: %v", err)
+	}
+	return claims
+}
+
+// exchangeCode runs an authorization code grant through /token and then the
+// resulting access token through /userinfo, returning the ID token claims
+// and the userinfo response.
+func exchangeCode(t *testing.T, s *IDPServer, who *apitype.WhoIsResponse) (map[string]any, map[string]any) {
+	t.Helper()
+	const (
+		code        = "test-code"
+		redirectURI = "https://rp.example.com/callback"
+	)
+
+	s.mu.Lock()
+	s.code[code] = &AuthRequest{
+		FunnelRP:    s.funnelClients["test-client"],
+		ClientID:    "test-client",
+		RedirectURI: redirectURI,
+		Scopes:      []string{"openid", "profile", "email"},
+		RemoteUser:  who,
+		ValidTill:   time.Now().Add(5 * time.Minute),
+	}
+	s.mu.Unlock()
+
+	form := url.Values{
+		"grant_type":    {"authorization_code"},
+		"code":          {code},
+		"redirect_uri":  {redirectURI},
+		"client_id":     {"test-client"},
+		"client_secret": {"test-secret"},
+	}
+	rr := httptest.NewRecorder()
+	s.serveToken(rr, postTokenForm(form))
+	if rr.Code != http.StatusOK {
+		t.Fatalf("serveToken() = %d: %s", rr.Code, rr.Body.String())
+	}
+
+	var tokenResp oidcTokenResponse
+	if err := json.Unmarshal(rr.Body.Bytes(), &tokenResp); err != nil {
+		t.Fatalf("failed to unmarshal token response: %v", err)
+	}
+
+	req := httptest.NewRequest("GET", "/userinfo", nil)
+	req.Header.Set("Authorization", "Bearer "+tokenResp.AccessToken)
+	rr = httptest.NewRecorder()
+	s.serveUserInfo(rr, req)
+	if rr.Code != http.StatusOK {
+		t.Fatalf("serveUserInfo() = %d: %s", rr.Code, rr.Body.String())
+	}
+
+	var info map[string]any
+	if err := json.Unmarshal(rr.Body.Bytes(), &info); err != nil {
+		t.Fatalf("failed to unmarshal userinfo: %v", err)
+	}
+	return decodeIDTokenClaims(t, tokenResp.IDToken), info
+}
+
+// TestUsernameClaimsFromDisplayName runs /token and /userinfo end to end:
+// the username claims are derived from the WhoIs display name per the
+// deployment invariant, falling back to the LoginName local part when the
+// display name yields nothing, and omitted when LoginName has no @.
+func TestUsernameClaimsFromDisplayName(t *testing.T) {
+	tests := []struct {
+		name string
+		// WhoIs identity
+		loginName   string
+		displayName string
+		// expectations; a string, or nil for an absent claim
+		wantPreferred any
+		wantUsername  any
+		wantName      any // userinfo name: the raw display name, or absent
+	}{
+		{
+			name:          "display name becomes the username",
+			loginName:     "jack@example.com",
+			displayName:   "Jack",
+			wantPreferred: "jack",
+			wantUsername:  "jack",
+			wantName:      "Jack",
+		},
+		{
+			name:          "multi-word display name",
+			loginName:     "jack@example.com",
+			displayName:   "Mary Jane",
+			wantPreferred: "mary_jane",
+			wantUsername:  "mary_jane",
+			wantName:      "Mary Jane",
+		},
+		{
+			name:          "email-shaped display name falls back to LoginName local part",
+			loginName:     "jack@example.com",
+			displayName:   "jack@example.com",
+			wantPreferred: "jack",
+			wantUsername:  "jack",
+			wantName:      "jack@example.com",
+		},
+		{
+			name:          "no @ in LoginName and no display name: claims absent",
+			loginName:     "plainname",
+			displayName:   "",
+			wantPreferred: nil,
+			wantUsername:  nil,
+			wantName:      nil,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			s := setupTestServer(t, nil)
+			claims, info := exchangeCode(t, s, displaynameTestUser(tt.loginName, tt.displayName))
+
+			if got, ok := claims["preferred_username"]; ok != (tt.wantPreferred != nil) || (ok && got != tt.wantPreferred) {
+				t.Errorf("ID token preferred_username = %v (present: %v), want %v", got, ok, tt.wantPreferred)
+			}
+			if got, ok := info["username"]; ok != (tt.wantUsername != nil) || (ok && got != tt.wantUsername) {
+				t.Errorf("userinfo username = %v (present: %v), want %v", got, ok, tt.wantUsername)
+			}
+
+			// email, name and sub are untouched by the derivation.
+			wantEmail := s.realishEmail(tt.loginName)
+			if claims["email"] != wantEmail {
+				t.Errorf("ID token email = %v, want %v", claims["email"], wantEmail)
+			}
+			if info["email"] != wantEmail {
+				t.Errorf("userinfo email = %v, want %v", info["email"], wantEmail)
+			}
+			if got, ok := info["name"]; ok != (tt.wantName != nil) || (ok && got != tt.wantName) {
+				t.Errorf("userinfo name = %v (present: %v), want %v", got, ok, tt.wantName)
+			}
+			if claims["sub"] != "userid:1" {
+				t.Errorf("ID token sub = %v, want userid:1", claims["sub"])
+			}
+		})
+	}
+}
